#! /usr/bin/env bash

VALUES="values.txt"
RESULTS="results.txt"

# -----------------------------------------------------------------------------
# -------------------------------------------------- Only returns n values ----
get_n_values()
{
  echo "$(cat "$VALUES" | sort -R | tail -n $1 | paste -sd ' ')"
}

# -----------------------------------------------------------------------------
# --------------------------------------------------------------- Analysis ----
analysis()
{
  echo "------------------------- $1 values ----"
  echo " Total: $(cat $RESULTS | wc -l)"
  echo "    r: $(cat $RESULTS | grep r | wc -l)"
  echo "        ra : $(cat $RESULTS | grep "^ra$" | wc -l)"
  echo "        rb : $(cat $RESULTS | grep "^rb$" | wc -l)"
  echo "        rra: $(cat $RESULTS | grep "^rra$" | wc -l)"
  echo "        rrb: $(cat $RESULTS | grep "^rrb$" | wc -l)"
  echo "        rr : $(cat $RESULTS | grep "^rr$" | wc -l)"
  echo "        rrr: $(cat $RESULTS | grep "^rrr$" | wc -l)"
  echo "    p : $(cat $RESULTS | grep p | wc -l)"
  echo "        pa : $(cat $RESULTS | grep pa | wc -l)"
  echo "        pb : $(cat $RESULTS | grep pb | wc -l)"
  echo "    s  : $(cat $RESULTS | grep s | wc -l)"
  echo "        sa : $(cat $RESULTS | grep sa | wc -l)"
  echo "        sb : $(cat $RESULTS | grep sb | wc -l)"
  echo "        ss : $(cat $RESULTS | grep ss | wc -l)"
  echo
}

# -----------------------------------------------------------------------------
# ------------------------------------------------------------------ Check ----
check()
{
  TMP=$(get_n_values $1)
  ./push_swap $TMP > $RESULTS
  if [[ $(cat $RESULTS | ./checker $TMP) != "OK" ]]; then
    echo "^^^^^^^^^^^^^^^^^^ FAIL ^^^^^^^^^^^^^^^^^^"
    echo "^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^"
    echo
  fi
}

# -----------------------------------------------------------------------------
# ---------------------------------------------------- Generate new values ----
echo "" > "$VALUES"
# for (( i=-1000; i <= 1000; i++ )); do
for (( i=0; i <= 500; i++ )); do
  echo "$i " >> "$VALUES"
done

# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
if [[ "$1" == "debug" ]]; then
  TMP=$(get_n_values $2)
  ./push_swap $TMP > $RESULTS
  cat $RESULTS | ./checker --verbose $TMP
  analysis $1
elif [[ -z "$1" ]]; then
  for (( i = 5; i <= 30; i += 5)); do
    check $i
    analysis $i
  done
  for (( i = 100; i <= 500; i += 100)); do
    check $i
    analysis $i
  done
else
    check $i
    analysis $1
fi

rm -f "$VALUES"
rm -f "$RESULTS"
